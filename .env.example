# Часовий пояс: у ньому бот ставить дати замовлень. Має збігатися з поясом
# таблиці й Apps Script (перевірка: функція checkTimezones() у редакторі скрипта).
TZ=Europe/Kyiv

# === Telegram ===
# Токен від @BotFather
BOT_TOKEN=123456:ABC...
# Ваш Telegram ID (дізнатись: напишіть боту /id). Кілька — через кому.
ADMIN_IDS=123456789
# Куди слати сповіщення про замовлення (ID групи або ваш ID). Необов'язково.
# ADMIN_CHAT_ID=-1001234567890

# === Нова Пошта ===
# Ключ з бізнес-кабінету new.novaposhta.ua → Налаштування → Безпека → API-ключі
NP_API_KEY=
# Ці 5 значень видасть скрипт: python scripts/setup_np.py ВАШ_КЛЮЧ "Ваше місто"
NP_SENDER_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=
NP_SENDER_PHONE=
# Хто платить за доставку: Recipient (отримувач) або Sender (ви)
NP_PAYER_TYPE=Recipient
# Створювати ТТН одразу після підтвердження замовлення (1 — так, 0 — ні)
NP_AUTO_TTN=1
# Як часто перепитувати статуси ТТН у НП, секунд (3600 — раз на годину, 0 — вимкнути)
TTN_POLL_SECONDS=3600
# Як часто перечитувати таблицю (схвалені, тарифи, назви, залишки), секунд
SHEET_SYNC_SECONDS=600

# === Склад → прайс ===
# Складська таблиця (рідна Google-таблиця) — основний варіант
WAREHOUSE_SHEET_ID=1VAu2Y7G8ri7Z5mXfSgCquTpdHMbqorDlCO3lcoQ7k6A
# .xlsx у Drive із залишками — запасний варіант, якщо склад ведуть файлом
WAREHOUSE_FILE_ID=
# Як часто переносити залишки, секунд (0 — вимкнути).
# Поки не перевірено на живому файлі — тримаємо 0, перевіряти вручну /sync_stock
WAREHOUSE_SYNC_SECONDS=0
# Вкладки прайсу, куди дозволено писати залишок
WAREHOUSE_TABS=PE Umbrella System,Christmas tree in a pot
# Ключ службового акаунта: увесь JSON одним рядком або шлях до файла
GOOGLE_SERVICE_ACCOUNT_JSON=
# Додавати в ТТН «Контроль оплати» на суму «При отриманні» (потрібен IBAN у кабінеті НП)
NP_PAYMENT_CONTROL=1

# === Ціни ===
# Який дроп-тариф показувати в боті: drop1 / drop2 / drop3
PRICE_TIER=drop3

# === Журнал замовлень у Google Таблиці ===
# URL веб-додатка Apps Script (див. apps_script/orders_webhook.gs)
SHEET_WEBHOOK_URL=
# Секрет для Apps Script — те саме значення впишіть у Властивості скрипту
# (Apps Script → ⚙️ Налаштування проєкту → Властивості скрипту → SHEETS_API_SECRET).
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHEETS_API_SECRET=

# === Прайс-лист (для команди /reload) ===
PRICELIST_SHEET_ID=18OkfzTnujb_VFTX0UuDlkEwCBNiR1pFy5OeafHugYFg
PRICELIST_GID=0

# === Вебхук для замовлень із сайту (Weblium) ===
# Придумайте довгий секрет; замовлення надсилати POST-ом на
#   https://ВАШ-ХОСТ/weblium?secret=ЦЕЙ_СЕКРЕТ
# Порожньо — вебхук вимкнено.
WEBLIUM_SECRET=
PORT=8080
